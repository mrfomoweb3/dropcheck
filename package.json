{
  "name": "dropcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/fetch-metadata.ts --soft && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:live": "vitest run tests/live",
    "spike": "tsx spike/connect.ts",
    "seed-demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "demo:headless": "tsx --env-file=.env scripts/run-demo-headless.ts",
    "spike:funded": "tsx --env-file=.env spike/funded.ts",
    "fetch-metadata": "tsx scripts/fetch-metadata.ts",
    "smoke": "node scripts/ui-smoke.mjs",
    "e2e:fork": "node scripts/ui-e2e.mjs",
    "failure-paths": "tsx --env-file=.env spike/failure-paths.ts"
  },
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/extension-dapp": "^0.64.1",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
